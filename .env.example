# ==============================================================================
# SISTEMA DE INFORMACIÓN ACADÉMICA (SIA - CUCEI / UDG) - SPRINT 4
# ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
# Copiar este archivo como .env en la raíz (o en /backend y /frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CONFIGURACIÓN DE POSTGRESQL (MÓDULOS 1 AL 6 - RELACIONAL ACID)
# ------------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sia_cucei_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_LOCAL
DATABASE_URL=postgresql://postgres:CAMBIAR_PASSWORD_POSTGRES_LOCAL@127.0.0.1:5432/sia_cucei_db

# Roles DCL opcionales (definidos en Modulo_1/DCL_Modulo_1.sql)
POSTGRES_APP_ROLE=rol_app_backend
POSTGRES_AUDITOR_ROLE=rol_auditor_analitica

# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE MONGODB (MÓDULO 7 - PRODUCCIÓN CIENTÍFICA NOSQL)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=cucei_investigacion_db

# ------------------------------------------------------------------------------
# 3. SEGURIDAD, AUTENTICACIÓN Y JWT (FASTAPI BACKEND)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=sia_udg_cucei_super_secret_jwt_key_2026_cambiar_en_produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Contraseña institucional por defecto utilizada en Modulo_1/seeder_modulo_1.py (Bcrypt)
SEED_DEFAULT_PASSWORD=SIA_Udg2026!
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. SERVIDOR BACKEND (FASTAPI) Y FRONTEND (REACT + VITE)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VITE_API_URL=http://localhost:8000/api
